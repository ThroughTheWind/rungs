{
  "name": "@rungs/cli",
  "version": "0.5.0",
  "description": "Installs and maintains a repository's agentic development system, composed from modules.",
  "author": "Antoine Dancre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThroughTheWind/rungs.git"
  },
  "homepage": "https://docs.rungscli.com",
  "bugs": {
    "url": "https://github.com/ThroughTheWind/rungs/issues"
  },
  "type": "module",
  "bin": {
    "rungs": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "rungs": "node src/cli.ts",
    "test": "node --max-old-space-size=2048 --test --test-concurrency=1 test/*.test.js"
  },
  "files": [
    "dist",
    "src",
    "modules",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agents",
    "claude-code",
    "agent-skills",
    "scaffolding"
  ],
  "license": "MIT",
  "dependencies": {
    "saxes": "6.0.0",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
