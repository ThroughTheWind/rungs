---
import packageJson from "../../../package.json";
import Base from "../layouts/Base.astro";
// No `Console` here on purpose: WI-046 replaced the release-procedure block with a plain `<pre>`
// because it is a summary of a skill, not captured output, and `Console` renders a REAL OUTPUT
// chrome that would have contradicted the block's own caption. The import outlived the usage.
import { Callout, Claim, EnforcementTag, Measurement, TitleBlock } from "../design-system/components/index.js";
import { SITE } from "../site.config";

// Published-ness is an ordering against `latest`, not equality with it. The page used to ask
// `version === publishedVersion ? "npm latest" : "npm publication pending"`, which is correct for
// exactly one row and wrong for every release below it: v0.1.1 and v0.1.2 had been installable
// since 2026-08-15 and both rendered "npm publication pending". A changelog whose older entries
// claim to be unpublished is worse than no status column at all.
//
// A function declaration, not a `const` arrow: it is used above its definition below, and a
// `const` in module scope is not hoisted.
function cmpVersions(a: string, b: string): number {
  const [x, y] = [a.split(".").map(Number), b.split(".").map(Number)];
  return x[0] - y[0] || x[1] - y[1] || x[2] - y[2];
}

const packageVersion = packageJson.version as string;
// The registry is the authority, not this file. Verified 2026-09-05 with
// `npm view @rungs/cli dist-tags` → { latest: "0.4.0" }, published 2026-09-05T19:27:19Z,
// and a clean consumer installed it from the public registry and ran the binary.
// The registry's shasum for 0.4.0 is 15412278a2d7778b53d2f499385395543206e1a2, identical to
// the tarball `npm pack` produces from the tagged commit f7b6aa0 — so what is public is what
// was gated, not whatever happened to be on a disk at publish time. That is a stronger claim
// than "the version numbers agree" and it is the one worth making here.
// Written in the same session as the publish, which is runbook §6's last step for a measured
// reason: this constant read "0.1.2" for two days after 0.1.3 went out, and the page rendered
// "0.1.3 · npm publication pending" above a version anyone could already install.
const publishedVersion = "0.4.0";
const publishedDate = "2026-09-05";

// Whether a release is pending is derived, not asserted. The page used to state
// "<version> is tagged and ready for npm publication" from the package version alone — which is
// true only between the bump and the publish, and silently false for the rest of a version's life.
// After 0.2.0 shipped, the package version *is* the published version, and a page that kept
// calling it pending would have been wrong in the opposite direction to the bug above it.
const pending = cmpVersions(packageVersion, publishedVersion) > 0;

// Published-ness is an ordering against `latest`, not equality with it. The page used to ask
// `version === publishedVersion ? "npm latest" : "npm publication pending"`, which is correct for
// exactly one row and wrong for every release below it: v0.1.1 and v0.1.2 have been installable
// since 2026-08-15 and both rendered "npm publication pending". A changelog whose older entries
// claim to be unpublished is worse than no status column at all.
const status = (v: string) =>
  cmpVersions(v, publishedVersion) === 0
    ? "npm latest"
    : cmpVersions(v, publishedVersion) < 0
      ? "published"
      : "npm publication pending";

const releases = [
  {
    version: "0.4.0",
    date: "2026-09-05",
    kind: "minor",
    entries: [
      ["added", "Generated repositories share one managed .ai/rungs.mjs launcher pinned to an exact @rungs/cli version — local instructions and generated CI run the same one, and upgrade --to an exact version is the bounded path for advancing the pin."],
      ["added", "Module provenance can state that work was designed rather than extracted, with a first-person rationale instead of an invented source incident."],
      ["added", "The package suite runs a packed CLI against an isolated existing Git repository: authority preservation, origin-only stable refs, repeated checks, same-version upgrades and rollback."],
      ["fixed", "Module emission, upgrade and harness rendering preflight one canonical consumer-repository boundary before writing. Traversal, outward aliases, unpaired surrogates, hard-linked leaves, reserved-sink impersonation, cross-phase collisions and leaf-symlink redirects fail closed with no partial install, and missing-path comparison applies the same NFKD, full-case storage key as managed refs so APFS cannot collapse an alias past it."],
      ["fixed", "rungs land refuses before locks, gates or ref updates when any worktree holds the integration branch, names every holding path, and parks a verified merge when a holder appears mid-gate."],
      ["fixed", "rungs land advances integration and green in one no-dereference, expected-old transaction or writes neither, and a refusal parks the work on a collision-free recovery branch it never overwrites."],
      ["fixed", "rungs land proves inherited red against a clean detached checkout at the exact integration commit: a gate that passes only with the invoking checkout's ignored runtime is reported unverified and cannot advance."],
      ["fixed", "rungs backlog archive validates its root, move sources, destinations and every Markdown rewrite as one contained mutation set, so a forged or stale plan fails closed before anything is written."],
      ["fixed", "Both release-fragment gates now execute the contracts they declare — shipping code needs a fragment changed by the same branch or a same-line reasoned exemption, and stale versioned fragments reach the production runner through one strict table selector."],
      ["fixed", "changelog.d/CONSUMED_THROUGH records the version whose fragments were assembled, so an equal-version fragment left behind after a cut fails rather than reading as unreleased work."],
      ["fixed", "A release-note exemption counts only when the branch needing it wrote it. An inherited, duplicated, moved or copied changelog-ok: reason can remain as history but cannot waive unrelated work."],
      ["fixed", "release-version-consistent reads dotted values from JSON and TOML plus the configured XML element in Directory.Build.props, fails explicitly on a matched source that is malformed, missing or unsupported, and takes a real release.version_exclude parameter for independently versioned manifests."],
      ["fixed", "Consumer text gates and neutral-rule rendering read LF, CRLF and lone-CR checkouts with the same semantics; re-registering an unchanged managed gate block preserves surrounding bytes and line endings, and a semantic no-op no longer rewrites the install record."],
      ["fixed", "Declared module conflicts are enforced symmetrically and propagate through dependency edges; an explicit override names what it overruled."],
      ["fixed", "A freshly generated findings register passes its own schema instead of reading its visible empty placeholder as a malformed finding."],
      ["fixed", "Backlog branch reconciliation resolves a local stable branch, an exact origin ref or a sole remote-tracking ref deterministically, and fails closed on absence or ambiguity."],
    ],
  },
  {
    version: "0.3.1",
    date: "2026-08-17",
    kind: "patch",
    entries: [
      ["fixed", "backlog-merged-status had never worked on Linux or macOS — it passed a git format string through a shell, where the parentheses are a syntax error. It ships in four of five profiles."],
      ["fixed", "Three more gates read the module set through a path that only resolved on Windows, so a legitimate opt-in read as a non-spec key and gates with fixtures read as having none."],
      ["fixed", "CRLF checkouts defeated the anchors in emitted module content, so a rule that was present read as missing."],
      ["changed", "rungs runs its own gates in CI across ubuntu, macos and windows. Its first runs found every fix above in under a minute."],
      ["changed", "The release runbook now opens its irreversible section by reading the CI run for the commit being tagged. 0.3.0 was published on a red build."],
    ],
  },
  {
    version: "0.3.0",
    date: "2026-08-17",
    kind: "minor",
    entries: [
      ["added", "The concurrency loop: session start, preflight, land and worktrees — four commands the module had documented for weeks without any of them existing."],
      ["added", "land attributes each failure against the merge base — inherited never blocks, INTRODUCED does, and anything unattributable blocks too."],
      ["added", "rungs runs its own gates in CI across ubuntu, macos and windows on node 22.18 and 22. It had none."],
      ["added", "module-commands-exist: every command a module tells a repo to run must be one the CLI dispatches, both sides derived from the dispatch itself."],
      ["fixed", "The ci module shipped a workflow that failed on every run in three of five profiles, blaming the repo for it."],
      ["fixed", "backlog archive could never archive an epic whose children had landed, and skipped any item named like the template."],
      ["fixed", "setup wrote git config into the current directory while reporting success about the repo you named."],
      ["fixed", "--set confirmed overrides it had not applied, so a mistyped parameter installed the default and said otherwise."],
      ["changed", "release-version-consistent takes an exclude list, and this repo's site is versioned in lockstep rather than excluded."],
    ],
  },
  {
    version: "0.2.0",
    date: "2026-08-17",
    kind: "minor",
    entries: [
      ["added", "doctor --explain runs the detectors on a repo that never installed rungs, and plain doctor says the analysis exists."],
      ["added", "Detection treats an external issue tracker as a different paradigm, and add stops rather than installing over it."],
      ["added", "rungs backlog archive, and a self-test runner that executes each gate's fixtures on every check."],
      ["added", "The skill-extension opt-in, so a repo can extend a module's skill and keep it through upgrade."],
      ["added", "release-fragment-current: a changelog fragment below the version being prepared was consumed by an earlier release and should have been deleted."],
      ["changed", "A gate tier is an ordered level, not a tag (ADR-0008): full is a superset of fast, and an undeclared tier is refused instead of passing empty. Breaking for a consumer using tiers as disjoint sets."],
      ["changed", "Detector applicability is declared per gate with no default (ADR-0007)."],
      ["changed", "The site derives its structural counts from the registry and refuses to build when they drift."],
      ["fixed", "upgrade re-registers a module's gates and updates the install record without touching diverged files."],
      ["fixed", "Link checking resolves file.ts:387 code references, and the REAL OUTPUT label only sits above captured output."],
      ["fixed", "A tier that matches no gate now names the tier and exits non-zero, instead of asking whether this is a rungs repo. The cut-release skill gated on it."],
    ],
  },
  {
    version: "0.1.3",
    date: "2026-08-15",
    kind: "patch",
    entries: [
      ["added", "The design-system Versions & changelog page and release-history surface."],
      ["changed", "The shared footer now links Versions, npm, and GitHub without stale phase or namespace claims."],
      ["changed", "Package metadata, README, roadmap, and site navigation agree on the next release."],
    ],
  },
  {
    version: "0.1.2",
    date: "2026-08-15",
    kind: "patch",
    entries: [["changed", "Package metadata and the public homepage now point to docs.rungscli.com."]],
  },
  {
    version: "0.1.1",
    date: "2026-08-15",
    kind: "patch",
    entries: [
      ["added", "A bundled JavaScript rungs executable for clean Node 22 consumers."],
      ["added", "The self-declared-finding-closure gate and regression coverage."],
      ["changed", "The static site moved to Astro 7.2.2 with a clean consumer smoke journey."],
    ],
  },
];

// Derived, not typed. This was a hand-kept table and three of its fifteen versions were already
// wrong — `backlog`, `adr` and `session` were bumped this week and the page still named the old
// numbers. Exactly what WI-051 fixed for the gate counts, on a page that had been missed.
const modules = SITE.modules.map((m) => [m.name, m.version] as const);
---

<Base
  title="Versions & changelog — rungs"
  description="Published rungs versions, the next package release, and the changelog discipline that keeps the version honest."
  srHeading="rungs versions and changelog"
  width={1000}
>
  <div class="sheet">
    <TitleBlock
      kicker="Versions"
      title="Versions & changelog"
      fields={[
        { label: "Latest", value: `${publishedVersion} · published ${publishedDate}` },
        { label: "Next", value: pending ? `${packageVersion} · prepared, not yet published` : "candidate/0.4.1 open · nothing pending" },
        { label: "Updated", value: SITE.asOf },
      ]}
    />

    <section class="releases">
      <span class="lab">Release history · assembled from changelog fragments</span>
      <div class="release-list">
        {releases.map((release) => (
          <article class="release-card">
            <div class="release-head">
              <span class="release-version">v{release.version}</span>
              <span class="release-meta">{release.date} · {release.kind} · {status(release.version)}</span>
            </div>
            <div class="release-body">
              {release.entries.map(([kind, text]) => (
                <div class="release-entry">
                  <span class:list={["entry-kind", { "is-fixed": kind === "fixed" }]}>{kind}</span>
                  <span>{text}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      {pending ? (
        <div class="next-card">
          <span class="next-label">Release prepared · not yet published</span>
          <p>
            <code>v{packageVersion}</code> is assembled from its changelog fragment and the package
            metadata agrees with it. The tag, the deploy branch and npm publication are the
            remaining steps — each one deliberate, because the tag and the registry are the two
            things this procedure cannot undo. The runbook is
            <code>docs/design/release-runbook.md</code>.
          </p>
        </div>
      ) : (
        <div class="next-card is-shipped">
          <span class="next-label">Nothing pending</span>
          <p>
            <code>v{publishedVersion}</code> is tagged, deployable from <code>release/{publishedVersion}</code>, and on npm as <code>latest</code>. Work for the
            next release lands on <code>candidate/0.4.1</code>, and the version it becomes is
            decided from the fragments in <code>changelog.d/</code> at cut time — not from this
            sentence, and not from the branch name.
          </p>
        </div>
      )}
    </section>

    <section class="sec">
      <span class="lab">Status · what exists alongside the version</span>
      <div class="status">
        <Measurement
          value={`${SITE.registered} gates register, plus ${SITE.hooks} hook that fires on a tool call and ${SITE.explainOnly} explain-only detector`}
          date={SITE.asOf}
          command="npx @rungs/cli check"
        />
        <span class="mono">{SITE.run.pass} pass</span>
        <span class="mono bad">{SITE.run.fail} fail</span>
        <span class="mono dim">{SITE.run.unimplemented} unimplemented · {SITE.modules.length} modules</span>
      </div>
    </section>

    <section class="sec">
      <span class="lab">The release model · defined before the first release</span>
      <p class="body">
        <Claim kind="evidence" cite="pattern-catalog §H">candidate-and-release-lines</Claim> keeps
        <code>candidate/&lt;version&gt;</code> integrating the next release, <code>main</code> stable,
        and <code>release/&lt;version&gt;</code> deployable and rollbackable. The version is chosen from
        the fragments at release time; branch names are prefixes, not promises.
      </p>
      {/*
        Not a `Console`. Its own `source` used to say "the procedure, not a transcript" while the
        component rendered `REAL OUTPUT` above it — a block honest in its text and contradicted by
        its own chrome (WI-046). This is a summary of a skill document, so it is presented as one.
      */}
      <pre class="procedure"><code>{[
        "cut-release: initialize boundary → decide from fragments → gate",
        "             → assemble/delete + advance boundary → bump → final gate",
        "             → tag → cut release/<version> → open next candidate",
        "hotfix:      fix + fragment → same prepare/bump/final gate → patch tag",
        "             → merge stable + forward into candidate",
        "rollback:    point deploy at previous release/<version>; never revert commits",
      ].join("\n")}</code></pre>
      <p class="cap">
        Summarised from <code>modules/release/skills/cut-release/SKILL.md</code>. Not command output.
      </p>
    </section>

    <section class="sec">
      <span class="lab">Changelog discipline · fragments, not memory</span>
      <div class="discipline">
        <div class="card">
          <div class="card-title">Entries land with the change</div>
          <p>Each release-worthy change adds one fragment to <code>changelog.d/</code> on the same branch. The next version is decided from those fragments, not reconstructed at tag time. After assembly, <code>CONSUMED_THROUGH</code> advances with the version so an equal-version fragment left behind cannot look unreleased.</p>
          {/*
            WI-070 found that both earlier green results were false-greens: one gate used a table
            schema its engine never read, while the production runner handed the other engine the
            whole table. Their fixtures and production dispatch now fail when either path regresses.
          */}
          <div class="tag-line"><EnforcementTag state="gated" /> <span>release-changelog-fragment · change-requires-file</span></div>
          <div class="tag-line"><EnforcementTag state="gated" /> <span>release-fragment-current · changelog-freshness, boundary-backed in 0.4.0</span></div>
        </div>
        <div class="card">
          <div class="card-title">The version agrees with itself</div>
          <p><code>release-version-consistent</code> compares configured JSON, TOML and XML version sources rather than trusting the releaser. TOML participation shipped in 0.4.0, which is why this sentence no longer holds it back; a matched source that is malformed, missing or unsupported fails explicitly rather than dropping out of the comparison and leaving a green built on fewer files than you think.</p>
          <div class="tag-line"><EnforcementTag state="gated" /> <span>release-version-consistent · computed-claim</span></div>
        </div>
      </div>
    </section>

    <section class="sec">
      <span class="lab">Module versions · what rungs records</span>
      <p class="body">Installed modules are pinned in <code>.ai/rungs.toml</code>, while managed regions carry the module version that wrote them. <code>doctor</code> reports divergence and <code>upgrade</code> leaves overridden regions alone.</p>
      <pre>&lt;!-- rungs:begin backlog@1.0.0 --&gt;
…managed content…
&lt;!-- rungs:end backlog@1.0.0 --&gt;</pre>
      <table class="modules">
        <thead><tr><th>module</th><th>version</th><th>status</th></tr></thead>
        <tbody>
          {modules.map(([name, version]) => <tr><td>{name}</td><td>{version}</td><td>authored</td></tr>)}
        </tbody>
      </table>
    </section>

    <section class="sec">
      <Callout kind="note">
        Published versions are immutable. The next release is assembled from its fragments, tagged,
        and published once; it is never rewritten in place after users can install it.
      </Callout>
    </section>
  </div>
</Base>

<style>
  .procedure {
    border: 1px solid var(--line);
    background: var(--surface-card);
    padding: 14px 16px;
    overflow-x: auto;
    font: 400 12.5px/1.65 var(--font-mono);
    color: var(--ink-2);
  }
  .cap {
    font: italic 400 12.5px/1.5 var(--font-serif);
    color: var(--text-muted);
    margin-top: 8px;
  }
  .sheet { padding: 40px 0 64px; }
  .releases { padding: 28px 0 4px; }
  .sec { padding: 32px 0; border-top: 1px solid var(--line); }
  .lab { font: 600 10px var(--font-label); letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 12px; }
  .release-list { display: flex; flex-direction: column; gap: 14px; }
  .release-card { border: 1px solid var(--ink); background: var(--surface-card); box-shadow: var(--shadow-sheet); }
  .release-head { display: flex; gap: 14px; align-items: baseline; padding: 10px 14px; border-bottom: 1px solid var(--ink); flex-wrap: wrap; }
  .release-version { font: 700 17px var(--font-display); }
  .release-meta { font: 400 12px var(--font-mono); color: var(--text-muted); }
  .release-body { padding: 10px 14px; display: flex; flex-direction: column; gap: 6px; }
  .release-entry { display: flex; gap: 10px; align-items: baseline; font: 400 13.5px/1.5 var(--font-serif); }
  .entry-kind { color: var(--text-muted); flex: none; width: 58px; font: 600 9.5px var(--font-label); letter-spacing: .1em; text-transform: uppercase; }
  .entry-kind.is-fixed { color: var(--redline); }
  .next-card { margin-top: 14px; border: 2px dashed var(--redline); background: var(--redline-tint); padding: 14px 16px; max-width: 72ch; }
  /* Nothing outstanding is not a warning. The dashed redline says "act on this"; a shipped
     release has nothing to act on, so it drops back to the ordinary card treatment. */
  .next-card.is-shipped { border: 1px solid var(--line); background: var(--surface-card); }
  .next-card.is-shipped .next-label { color: var(--text-muted); }
  .next-label { color: var(--redline); display: block; margin-bottom: 6px; font: 600 10px var(--font-label); letter-spacing: .1em; text-transform: uppercase; }
  .next-card p, .body { font: 400 14.5px/1.6 var(--font-serif); color: var(--ink-2); margin: 0; max-width: 72ch; }
  .status { display: flex; gap: 24px; align-items: baseline; flex-wrap: wrap; }
  .mono { font: 500 14px var(--font-mono); }
  .bad { color: var(--redline); }
  .dim { color: var(--text-muted); font-weight: 400; }
  .discipline { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .card { border: 1px solid var(--line); background: var(--surface-card); padding: 12px 14px; }
  .card-title { font: 600 13px var(--font-display); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; }
  .card p { font: 400 13.5px/1.6 var(--font-serif); color: var(--ink-2); margin: 0; }
  .tag-line { margin-top: 10px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font: 400 11.5px var(--font-mono); color: var(--text-muted); }
  pre { max-width: 560px; overflow-x: auto; margin: 14px 0 0; }
  .modules { background: var(--surface-card); border: 1px solid var(--ink); margin-top: 14px; }
  .modules td:first-child, .modules td:nth-child(2) { font: 500 12.5px var(--font-mono); }
  .modules td:last-child { color: var(--text-muted); font: 400 12.5px var(--font-mono); }
  @media (max-width: 700px) { .discipline { grid-template-columns: 1fr; } }
</style>
