---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.config";
import { Button, Callout, Console, Measurement, ModuleCard } from "../design-system/components/index.js";

// Derived, not typed (WI-051). These were two hand-kept inventories under a `generate-derivable`
// TODO, in a file arguing that hand-kept inventories go stale. Name, rung, dependencies and summary
// now come from `modules/*/module.toml` through `generated/claims.json`; `npm run claims` rewrites
// it and the `site-claims-current` gate refuses a snapshot that has drifted.
// Deriving them cost the literal types the hand-written array used to carry: JSON widens `rung` to
// `number`, and `ModuleCard` accepts `0 | 1 | … | 5`. `astro check` had been red on this since
// WI-051. Narrowing here rather than in the vendored component, and *checking* rather than
// asserting — a rung outside the ladder is a manifest defect, and a bare `as` would render it as a
// badge instead of reporting it.
const asRung = (r: number, name: string) => {
  if (!Number.isInteger(r) || r < 0 || r > 5) {
    throw new Error(`module ${name}: rung ${r} is outside the 0–5 ladder`);
  }
  return r as 0 | 1 | 2 | 3 | 4 | 5;
};

const MODULES = SITE.modules.map((m) => [m.name, asRung(m.rung, m.name), m.requires, m.summary] as const);

// The "for what" line stays authored: it is editorial, not a fact about the repo, and there is
// nowhere in `modules/` it could honestly be read from. The module *set* per profile is derived,
// so a profile that gains a module cannot silently keep the old list.
const PROFILE_FOR: Record<string, string> = {
  minimal: "any repo with an agent",
  tracked: "more than one work item in flight",
  disciplined: "repeated work of the same shape",
  hardened: "rules broken at least once",
  fleet: "5+ concurrent sessions",
};
const RUNG_OF = new Map(SITE.modules.map((m) => [m.name, m.rung]));
const PROFILES = SITE.profiles.map((p, i) => {
  const prior = new Set(i ? SITE.profiles[i - 1].modules : []);
  const added = p.modules.filter((m) => !prior.has(m));
  return [
    p.name,
    Math.max(...p.modules.map((m) => RUNG_OF.get(m) ?? 0)),
    (i ? "+ " : "") + added.join(" · "),
    PROFILE_FOR[p.name] ?? "",
  ] as const;
});

const REPOS = [
  ["axiom-mesh", "2026-03 → 04", "73 commits · 48+ ADRs", "doc authority + prompt library"],
  ["hexguard", "2026-06 → 07", "507 commits · 105 packages", "scoped instructions + checklists"],
  ["hexguard-templates", "2026-07", "319 commits", "spec-first + story workflow"],
  ["rift-forge", "2026-07-29 → 08-15", "3,585 commits · 433 branches", "mechanical gates + concurrency"],
] as const;

const g = SITE.run;
---

<Base
  title="rungs — reinforce the repo you already have"
  description="rungs CLI — repository infrastructure for coding agents. It reports what your repo's agentic development system already has, then installs only what is missing, as 15 composable modules extracted from four repos that already paid for the lessons. Start with npx @rungs/cli doctor."
>
  <section class="hero">
    <div>
      <h1>Your repo already stands.<br />Reinforce it.</h1>
      <p class="lede">
        rungs installs and maintains a repository's agentic development system — backlog, findings,
        gates, skills — composed from modules extracted from four repos that already paid for the
        lessons.
      </p>
      <p class="sub">Start read-only: <code>npx @rungs/cli doctor</code>. It writes nothing.</p>
      <div class="cta">
        <Button href="#modules">Browse the 15 modules</Button>
        <Button variant="ghost" href="#extracted">How the content was extracted</Button>
      </div>
    </div>
    <div>
      <Console
        date="2026-08-16"
        source="npx @rungs/cli doctor, on a repo that has never installed anything"
        lines={[
          { type: "cmd", text: "npx @rungs/cli doctor" },
          { type: "out", text: "  ci             theirs" },
          { type: "dim", text: "      1× .github/workflows/*.yml  e.g. .github/workflows/ci.yml" },
          { type: "dim", text: "  1 present · 0 different paradigm · 14 absent" },
          { type: "out", text: "  Next" },
          { type: "out", text: "  rungs add ci  — adopt what you already built, in place" },
        ]}
      />
      <p class="cap">Detection runs on repos that never installed rungs. It ends by naming one command — never the maximal one.</p>
    </div>
  </section>

  <section class="sec">
    <span class="lab">Status · stated, not softened</span>
    <div class="status">
      <Measurement
        value={`${SITE.registered} gates register, plus ${SITE.hooks} hook that fires on a tool call`}
        date={SITE.asOf}
        command="npx @rungs/cli check"
      />
      <span class="mono">{g.pass} pass</span>
      <span class="mono bad">{g.fail} fail</span>
      <span class="mono dim">{g.unimplemented} unimplemented · {SITE.phase.label}</span>
    </div>
  </section>

  <section class="sec" id="extracted">
    <span class="lab">Extracted, not invented</span>
    <div class="grid4">
      {
        REPOS.map(([name, period, scale, style]) => (
          <div class="repo">
            <div class="repo-n">{name}</div>
            <div class="repo-m">{period} · {scale}</div>
            <div class="repo-w">{style}</div>
          </div>
        ))
      }
    </div>
    <p class="body">
      Read in date order they are one operator learning the same lessons four times. What worked
      became a module; what hurt became a guardrail. No repo has all four stages — that gap is the
      product.
    </p>
  </section>

  <section class="sec">
    <span class="lab">Install profiles · a progression, not tiers</span>
    <div class="profiles">
      {
        PROFILES.map(([name, rung, mods, forWhat]) => (
          <div class="profile">
            <div class="profile-hatch" style={`background:var(--hatch-r${rung})`}></div>
            <div class="profile-n">{name}</div>
            <div class="profile-m">{mods}</div>
            <div class="profile-f">{forWhat}</div>
          </div>
        ))
      }
    </div>
    <p class="cap">
      tracked is the rung two of the four source repos never reached — and both paid the same price.
    </p>
  </section>

  <section class="sec" id="modules">
    <span class="lab">The 15 modules · rung stated, dependencies refused if unmet</span>
    <div class="grid3">
      {MODULES.map(([name, rung, deps, blurb]) => <ModuleCard name={name} rung={rung} deps={[...deps]} blurb={blurb} />)}
    </div>
    <div class="mt">
      <Callout kind="note">
        Three dependency chains exist because a source repo violated them and paid:
        <code>audit → findings → backlog</code> (268 unactioned audit reports) ·
        <code>workflows → skills</code> (an uninvocable 9-step procedure) ·
        <code>doc-authority → gates</code> (non-negotiables that decayed in place).
      </Callout>
    </div>
  </section>

  <section class="sec">
    <span class="lab">The rung check · stated before it installs</span>
    <Console
      date="2026-08-16"
      source="npx @rungs/cli add concurrency, on a rung-1 repo"
      lines={[
        { type: "cmd", text: "npx @rungs/cli add concurrency" },
        { type: "warn", text: "  concurrency: requires 5+ concurrent sessions on one integration branch." },
        { type: "dim", text: "  Skipped — pass --confirm-threshold to install it." },
      ]}
    />
    <p class="body">
      Selling rung 5 to a rung-1 repo is the most likely way this tool does harm, so the refusal is
      the default and the override is explicit. Nothing is interactive: rungs runs unattended in the
      same sessions your agents do.
    </p>
  </section>

  <section class="sec">
    <span class="lab">Bring your own agent</span>
    <p class="body">
      rungs is not a methodology and not an orchestrator. It does not decide how your agent plans,
      specifies, or executes — it checks that the repository underneath stays coherent while it
      does. Whatever writes your code is welcome to keep writing it.
    </p>
    <p class="body">
      <code>AGENTS.md</code> is embraced rather than competed with. Skills are written to the
      Agent Skills spec and are portable unchanged; only <em>path-scoped rules</em> are genuinely
      fragmented across harnesses, so that is the only thing rungs renders per target — and anything
      a target cannot express is reported in <code>.ai/render-report.md</code>, never silently
      dropped (<a href="/wiki/decisions/adr-0001-multi-harness-rendering/">ADR-0001</a>).
    </p>
    <p class="cap">
      New here? <a href="/wiki/glossary/">The nine words this page uses</a>, defined once.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: 56px 0 48px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: start;
  }
  h1 {
    font: 700 46px/1.05 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .lede {
    font: 400 17.5px/1.6 var(--font-serif);
    margin-top: 18px;
    max-width: 46ch;
  }
  .sub {
    font: 400 14px/1.6 var(--font-mono);
    color: var(--text-muted);
    margin-top: 12px;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .cap {
    font: italic 400 12.5px/1.5 var(--font-serif);
    color: var(--text-muted);
    margin-top: 8px;
  }
  .sec {
    padding: 48px 0;
    border-top: 1px solid var(--line);
  }
  .lab {
    font: 600 10px var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 16px;
  }
  .status {
    display: flex;
    gap: 24px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .mono {
    font: 500 14px var(--font-mono);
  }
  .bad {
    color: var(--redline);
  }
  .dim {
    color: var(--text-muted);
    font-weight: 400;
  }
  .grid4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .repo {
    border: 1px solid var(--line);
    background: var(--surface-card);
    padding: 12px 14px;
  }
  .repo-n {
    font: 500 13.5px var(--font-mono);
  }
  .repo-m {
    font: 400 11px var(--font-mono);
    color: var(--text-muted);
    margin-top: 4px;
  }
  .repo-w {
    font: 400 12.5px/1.45 var(--font-serif);
    color: var(--ink-2);
    margin-top: 8px;
  }
  .body {
    font: 400 14.5px/1.6 var(--font-serif);
    color: var(--ink-2);
    margin-top: 16px;
    max-width: 72ch;
  }
  .profiles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--ink);
    background: var(--surface-card);
  }
  .profile {
    padding: 14px 14px 12px;
    border-left: 1px solid var(--ink);
  }
  .profile:first-child {
    border-left: 0;
  }
  .profile-hatch {
    height: 8px;
    border: 1px solid var(--ink);
    margin-bottom: 10px;
  }
  .profile-n {
    font: 700 15px var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .profile-m {
    font: 400 11px/1.5 var(--font-mono);
    color: var(--text-muted);
    margin: 6px 0;
  }
  .profile-f {
    font: italic 400 12px/1.4 var(--font-serif);
    color: var(--ink-2);
  }
  .mt {
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 36px;
    }
    h1 {
      font-size: 34px;
    }
    .grid4,
    .grid3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .profiles {
      grid-template-columns: 1fr;
    }
    .profile {
      border-left: 0;
      border-top: 1px solid var(--ink);
    }
    .profile:first-child {
      border-top: 0;
    }
  }
  @media (max-width: 560px) {
    .grid4,
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
</style>
