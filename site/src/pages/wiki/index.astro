---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { TitleBlock, Callout } from "../../design-system/components/index.js";
import { docTitle, shelf, SHELVES, SHELF_ORDER } from "../../lib/wiki";
import { sourceFor } from "../../lib/source-map.mjs";

const all = await getCollection("wiki");

// docs/README.md owns this route's prose; the registry below is derived, never hand-kept.
const root = all.find((d) => d.id === "");
const Intro = root ? (await render(root)).Content : null;

const entries = await Promise.all(
  all
    .filter((d) => d.id !== "")
    .map(async (d) => {
      const { headings } = await render(d);
      return {
        id: d.id,
        title: docTitle(d, headings),
        shelf: shelf(d.id),
        status: d.data.status,
        source: sourceFor(d.id),
      };
    }),
);

const grouped = SHELF_ORDER.map((s) => ({
  shelf: s,
  label: SHELVES[s],
  docs: entries.filter((e) => e.shelf === s).sort((a, b) => a.id.localeCompare(b.id)),
})).filter((g) => g.docs.length);

// "Built" is the build, not a measurement. It read `site.config`'s `asOf` — a hand-typed date that
// only moves when someone remembers — so the registry claimed a freshness nobody had checked. Astro
// frontmatter runs at build time, so this is the one date on the site that can simply be taken.
const builtOn = new Date().toISOString().slice(0, 10);
---

<Base
  title="Wiki — rungs"
  description={`The rungs corpus published in full: ${entries.length} documents across research, design, decisions and the backlog, rendered from the repository's own markdown.`}
  srHeading="rungs wiki — documentation"
  width={1100}
>
  <div class="sheet">
    <TitleBlock
      kicker="Wiki"
      title="Documentation"
      fields={[
        { label: "Corpus", value: "docs/ · rendered from plain markdown" },
        { label: "Documents", value: String(entries.length + (root ? 1 : 0)) },
        { label: "Built", value: builtOn },
      ]}
    />

    {Intro && <article class="prose intro"><Intro /></article>}

    {
      grouped.map((g) => (
        <section class="sec">
          <span class="lab">{g.label}</span>
          <table class="reg">
            <thead>
              <tr>
                <th>document</th>
                <th>source</th>
                <th>status</th>
              </tr>
            </thead>
            <tbody>
              {g.docs.map((d) => (
                <tr>
                  <td class="reg-t">
                    <a href={`/wiki/${d.id}/`}>{d.title}</a>
                  </td>
                  <td class="reg-s">{d.source ?? "unmapped"}</td>
                  <td class="reg-x">{d.status ?? "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }

    <div class="sec">
      <Callout kind="note">
        This registry is derived from the files in <code>docs/</code> at build time, not hand-kept.
        A document that exists appears here; one that is deleted stops appearing. Titles come from
        frontmatter where there is any, and from the document's own H1 where there is not.
      </Callout>
    </div>
  </div>
</Base>

<style>
  .sheet {
    padding: 40px 0 64px;
  }
  .intro {
    margin: 28px 0 8px;
    max-width: var(--measure);
  }
  .intro :global(h1) {
    display: none;
  }
  .intro :global(p),
  .intro :global(ul),
  .intro :global(table) {
    margin: 12px 0;
  }
  .sec {
    padding: 28px 0 0;
    border-top: 1px solid var(--line);
    margin-top: 28px;
  }
  .lab {
    font: 600 10px var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 12px;
  }
  .reg {
    background: var(--surface-card);
    border: 1px solid var(--ink);
  }
  .reg-t a {
    font: 500 14px var(--font-serif);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .reg-s {
    font: 400 11.5px var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .reg-x {
    font: 600 10px var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  @media (max-width: 560px) {
    .reg-s {
      display: none;
    }
  }
</style>
