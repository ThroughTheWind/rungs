---
import "../design-system/styles.css";
import { SITE, NAV } from "../site.config";

interface Props {
  title: string;
  description?: string;
  /** Constrains the main column. Wiki articles run wider than prose-only pages. */
  width?: number;
}

const { title, description = SITE.tagline, width = 1060 } = Astro.props;
const here = Astro.url.pathname;
const isHere = (href: string) => here === href || (href !== "/" && here.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(here, Astro.site ?? "https://rungs.dev")} />
    {/* Applied before first paint: a theme that flashes is a theme that was applied too late. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("rungs-theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          if (t === "dark") document.documentElement.dataset.theme = "dark";
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <nav class="nav">
      <div class="nav-in" style={`max-width:${width}px`}>
        <a class="wordmark" href="/">rungs</a>
        {
          NAV.map((item) => (
            <a
              class:list={["nav-link", { "is-here": !("external" in item) && isHere(item.href) }]}
              href={item.href}
              {...("external" in item ? { rel: "noopener", target: "_blank" } : {})}
            >
              {item.label}
            </a>
          ))
        }
        <span class="nav-gap"></span>
        <span class="nav-status">{SITE.phase.label} · {SITE.asOf}</span>
        <button class="rgs-btn rgs-btn-secondary rgs-btn-sm" id="theme" type="button" aria-live="polite">
          Blueprint
        </button>
      </div>
    </nav>

    <main id="main" style={`max-width:${width}px`}>
      <slot />
    </main>

    <footer class="foot" style={`max-width:${width}px`}>
      <div class="foot-text">
        {SITE.phase.detail}<br />
        {SITE.openTrigger}
      </div>
      <div class="foot-mark">rungs</div>
    </footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("theme");
        if (!b) return;
        var sync = function () {
          b.textContent = document.documentElement.dataset.theme === "dark" ? "Paper" : "Blueprint";
        };
        sync();
        b.addEventListener("click", function () {
          var dark = document.documentElement.dataset.theme === "dark";
          if (dark) delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = "dark";
          try {
            localStorage.setItem("rungs-theme", dark ? "light" : "dark");
          } catch (e) {}
          sync();
        });
      })();
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--sheet);
        border: var(--border-sheet);
        padding: 10px 16px;
        z-index: 10;
      }
      .skip:focus {
        left: 16px;
        top: 12px;
      }
      .nav {
        border-bottom: 1px solid var(--ink);
        background: var(--surface-card);
      }
      .nav-in {
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }
      .wordmark {
        font: 700 17px var(--font-display);
        color: var(--ink);
        text-decoration: none;
        padding: 14px 12px 14px 0;
        margin-right: 8px;
      }
      .nav-link {
        font: 600 12px var(--font-label);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        text-decoration: none;
        padding: 14px 12px;
        min-height: var(--target-min);
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        border-bottom: 2px solid transparent;
      }
      .nav-link:hover {
        color: var(--ink);
      }
      .nav-link.is-here {
        color: var(--ink);
        border-bottom-color: var(--redline);
      }
      .nav-gap {
        flex: 1;
      }
      .nav-status {
        font: 400 11px var(--font-mono);
        color: var(--text-muted);
        margin-right: 12px;
      }
      main {
        margin: 0 auto;
        padding: 0 32px;
        display: block;
      }
      .foot {
        margin: 0 auto;
        padding: 24px 32px 56px;
        border-top: 1px solid var(--ink);
        display: flex;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }
      .foot-text {
        font: 400 12px/1.7 var(--font-mono);
        color: var(--text-muted);
      }
      .foot-mark {
        font: 700 28px var(--font-display);
        color: var(--ink);
      }
      @media (max-width: 560px) {
        .nav-status {
          display: none;
        }
        .nav-in,
        main,
        .foot {
          padding-left: 16px;
          padding-right: 16px;
        }
      }
    </style>
  </body>
</html>
