---
import "../design-system/styles.css";
// The bar mark, inline rather than an <img>: it is drawn in `currentColor`, so one file serves
// both themes and both placements. Vendored from the design system — never edited here.
import logoSvg from "../design-system/assets/logo.svg?raw";
import { SITE, NAV } from "../site.config";

interface Props {
  title: string;
  description?: string;
  /** Constrains the main column. Wiki articles run wider than prose-only pages. */
  width?: number;
  /**
   * Accessible page heading for pages whose visible title is a `TitleBlock`, which renders a div.
   * Set it and the layout emits a screen-reader-only `<h1>`; otherwise the page supplies its own.
   */
  srHeading?: string;
}

const { title, description = SITE.tagline, width = 1060, srHeading } = Astro.props;
const here = Astro.url.pathname;
const isHere = (href: string) => here === href || (href !== "/" && here.startsWith(href));

const origin = Astro.site ?? new URL("https://docs.rungscli.com");
const canonical = new URL(here, origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />

    {/* Icons are generated from the design system's `assets/logo.svg` by `npm run vendor`; the
        .ico carries its own paper ground because a tab icon cannot follow the page theme. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Still no og:image. The design system now ships a mark (2026-08-15), but a 1200×630 share
        card is a composition nobody has drawn — cropping the mark into one would be an asset
        invented here, not extracted. Text-only tags until that card exists. */}
    <meta property="og:type" content={here === "/" ? "website" : "article"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {/* Applied before first paint: a theme that flashes is a theme that was applied too late. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("rungs-theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          if (t === "dark") document.documentElement.dataset.theme = "dark";
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <nav class="nav">
      <div class="nav-in" style={`max-width:${width}px`}>
        <a class="wordmark" href="/" aria-label={`${SITE.name} — home`}>
          <span class="mark" aria-hidden="true" set:html={logoSvg} />rungs
        </a>
        {
          NAV.map((item) => (
            <a
              class:list={["nav-link", { "is-here": !("external" in item) && isHere(item.href) }]}
              href={item.href}
              {...("external" in item ? { rel: "noopener", target: "_blank" } : {})}
            >
              {item.label}
            </a>
          ))
        }
        <span class="nav-gap"></span>
        <span class="nav-status">Updated · {SITE.asOf}</span>
        <button class="rgs-btn rgs-btn-secondary rgs-btn-sm" id="theme" type="button" aria-live="polite">
          Blueprint
        </button>
      </div>
    </nav>

    <main id="main" style={`max-width:${width}px`}>
      {srHeading && <h1 class="sr-only">{srHeading}</h1>}
      <slot />
    </main>

    <footer class="foot" style={`max-width:${width}px`}>
      <div class="foot-text">
        {SITE.tagline}<br />
        <a href={SITE.npm} rel="noopener" target="_blank">Install @rungs/cli from npm</a><br />
        {SITE.openTrigger}
      </div>
      <div class="foot-mark"><span class="mark" aria-hidden="true" set:html={logoSvg} />rungs</div>
    </footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("theme");
        if (!b) return;
        var sync = function () {
          b.textContent = document.documentElement.dataset.theme === "dark" ? "Paper" : "Blueprint";
        };
        sync();
        b.addEventListener("click", function () {
          var dark = document.documentElement.dataset.theme === "dark";
          if (dark) delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = "dark";
          try {
            localStorage.setItem("rungs-theme", dark ? "light" : "dark");
          } catch (e) {}
          sync();
        });
      })();
    </script>

    <style>
      /* The visible title on these pages is a TitleBlock, which renders a div — so the document
         had no h1 at all. Upstream fix is a heading-level prop on TitleBlock; until the design
         system carries one, the heading exists for assistive tech and crawlers only. */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--sheet);
        border: var(--border-sheet);
        padding: 10px 16px;
        z-index: 10;
      }
      .skip:focus {
        left: 16px;
        top: 12px;
      }
      .nav {
        border-bottom: 1px solid var(--ink);
        background: var(--surface-card);
      }
      .nav-in {
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }
      .wordmark {
        font: 700 17px var(--font-display);
        color: var(--ink);
        text-decoration: none;
        padding: 14px 12px 14px 0;
        margin-right: 8px;
        display: inline-flex;
        align-items: center;
        /* Brand clear space: ≥ one bottom bar, which is 6 of the mark's 32 units. */
        gap: 9px;
      }
      /* The mark is injected with `set:html`, so Astro's scoping never lands on the <svg> itself
         — `:global()` here is required, not a shortcut. `fill="currentColor"` does the theming. */
      .mark {
        display: block;
        flex: none;
      }
      .wordmark .mark :global(svg) {
        display: block;
        width: 20px;
        height: 20px;
      }
      .nav-link {
        font: 600 12px var(--font-label);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        text-decoration: none;
        padding: 14px 12px;
        min-height: var(--target-min);
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        border-bottom: 2px solid transparent;
      }
      .nav-link:hover {
        color: var(--ink);
      }
      .nav-link.is-here {
        color: var(--ink);
        border-bottom-color: var(--redline);
      }
      .nav-gap {
        flex: 1;
      }
      .nav-status {
        font: 400 11px var(--font-mono);
        color: var(--text-muted);
        margin-right: 12px;
      }
      main {
        margin: 0 auto;
        padding: 0 32px;
        display: block;
      }
      .foot {
        margin: 0 auto;
        padding: 24px 32px 56px;
        border-top: 1px solid var(--ink);
        display: flex;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }
      .foot-text {
        font: 400 12px/1.7 var(--font-mono);
        color: var(--text-muted);
      }
      .foot-mark {
        font: 700 28px var(--font-display);
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .foot-mark .mark :global(svg) {
        display: block;
        width: 28px;
        height: 28px;
      }
      @media (max-width: 560px) {
        .nav-status {
          display: none;
        }
        .nav-in,
        main,
        .foot {
          padding-left: 16px;
          padding-right: 16px;
        }
      }
    </style>
  </body>
</html>
