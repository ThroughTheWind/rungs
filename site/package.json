{
  "name": "@rungs/site",
  "version": "0.3.0",
  "private": true,
  "description": "The rungs web surfaces: landing, wiki, contribute. Static Astro; the wiki is generated from the repo's own docs/.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "vendor": "node scripts/vendor-design-system.mjs",
    "check:vendored": "node scripts/check-vendored.mjs",
    "claims": "node scripts/generate-claims.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "transcripts": "node scripts/generate-transcripts.mjs",
    "check:transcripts": "node scripts/check-transcripts.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/precompress.mjs",
    "preview": "astro preview",
    "start": "sirv dist --host 0.0.0.0 --port ${PORT:-4321} --etag --gzip --brotli --single false",
    "check": "astro check && npm run check:links",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "sirv-cli": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-semi-condensed": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro": "^7.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "unist-util-visit": "^5.0.0"
  }
}
